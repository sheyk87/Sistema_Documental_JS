# ==========================================
# .env.docker — Ejemplo de configuración para Docker
# ==========================================
# Copiar este archivo como .env y ajustar los valores antes de desplegar:
#   cp .env.docker .env
#
# NOTA: DB_HOST y REDIS_HOST se sobreescriben automáticamente
# por docker-compose.yml (environment: DB_HOST=db, REDIS_HOST=redis)
# No es necesario cambiarlos aquí.

# ==========================================
# CONFIGURACIÓN DEL SERVIDOR
# ==========================================
PORT=3000
NODE_ENV=production

# ==========================================
# BASE DE DATOS MYSQL
# ==========================================
# NOTA: En Docker, DB_HOST se sobreescribe a "db" por el compose
DB_HOST=db
DB_USER=root
DB_PASSWORD=CAMBIAR_EN_PRODUCCION
DB_NAME=gde_system

# ==========================================
# SEGURIDAD JWT
# ==========================================
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_GENERAR_NUEVO_SECRETO

# ==========================================
# CIFRADO DE ARCHIVOS
# ==========================================
# Clave maestra de 32 bytes exactos para cifrado AES-256
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FILE_SECRET=CAMBIAR_32_BYTES_EXACTOS
STORAGE_ENCRYPTION_KEY=CAMBIAR_GENERAR_NUEVO_SECRETO

# ==========================================
# CORS - Orígenes permitidos (separados por coma)
# ==========================================
# Incluir el dominio final con HTTPS
CORS_ORIGINS=https://gde.sistema.com

# ==========================================
# CONFIGURACIÓN DE CORREO ELECTRÓNICO (SMTP)
# ==========================================
EMAIL_ENABLED=false
EMAIL_HOST=smtp.ejemplo.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=usuario@ejemplo.com
EMAIL_PASS=contraseña_de_aplicacion
EMAIL_FROM=Sistema GDE <usuario@ejemplo.com>

# ==========================================
# CONFIGURACIÓN DE LDAP / ACTIVE DIRECTORY
# ==========================================
LDAP_ENABLED=false
LDAP_URL=ldap://192.168.1.200:389
LDAP_DOMAIN=midominio.local

# ==========================================
# AUTENTICACIÓN DE DOS FACTORES (2FA)
# ==========================================
TWO_FACTOR_GLOBAL_ENABLED=true
TWO_FACTOR_MANDATORY=false

# ==========================================
# REDIS (Cache, Rate Limiting, Sesiones)
# ==========================================
# NOTA: En Docker, REDIS_HOST se sobreescribe a "redis" por el compose
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
